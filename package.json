{
  "name": "ecommerce-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ecommerce/web",
    "dev:backend": "turbo run dev --filter=@ecommerce/backend-service",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "format": "turbo run format",
    "test": "turbo run test",
    "db:migrate": "bun --filter=@ecommerce/backend-service run db:migrate",
    "db:rollback": "bun --filter=@ecommerce/backend-service run db:rollback",
    "db:fresh": "bun --filter=@ecommerce/backend-service run db:fresh",
    "db:status": "bun --filter=@ecommerce/backend-service run db:status",
    "db:seed": "bun --filter=@ecommerce/backend-service run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "bun@1.4.3"
}
